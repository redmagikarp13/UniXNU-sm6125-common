# SM6125 (Kryo 260: Cortex-A73 + Cortex-A53, ARMv8.0-A — no PAN, no LSE, no PAC)
CONFIG_XNU_NATIVE_PAN=n
# Evita o acesso físico hardcoded PLATFORM_PANIC_LOG_PADDR=0x3c0fc000 (BCM2837)
# antes de _initialize_screen(), que causa bus error em SoCs Qualcomm.
CONFIG_XNU_DT_PANIC_REGION=y
# Ponte ApplePMGRNub para satisfazer a AMFI pré-linkada em bare-metal.
CONFIG_XNU_SHENG_PMGR=y
# Sonda do controlador eMMC SDCC1 e sonda Touch QUPv3 SE2 SPI + NT36672A.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/sm6125-emmc-probe/libSm6125EmmcProbe.a -Wl,-force_load,{tree}/build/sm6125-touch-probe/libSm6125TouchProbe.a"
# Display framebuffer UEFI GOP -> IOMobileFramebuffer (NativeLegacyDisplay)
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
