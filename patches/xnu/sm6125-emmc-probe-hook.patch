+struct sm6125_ps_ctx {
+	char key_buf[160];
+	size_t key_len;
+	char tail_buf[192];
+	size_t tail_len;
+	uint32_t count;
+};
+static int
+sm6125_is_key_proc(const char *comm)
+{
+	static const char *const keys[] = {
+		"backboardd", "SpringBoard", "lsd", "PurpleBuddy",
+		"securityd", "mobileactiv", "keybagd", "com.apple.datam",
+	};
+	for (size_t i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
+		if (strncmp(comm, keys[i], strlen(keys[i])) == 0) {
+			return 1;
+		}
+	}
+	return 0;
+}
+static int
+sm6125_ps_visit(proc_t pr, void *arg)
+{
+	struct sm6125_ps_ctx *c = (struct sm6125_ps_ctx *)arg;
+	char *dst = c->tail_buf;
+	size_t *dlen = &c->tail_len, cap = sizeof(c->tail_buf);
+	c->count++;
+	if (sm6125_is_key_proc(pr->p_comm)) {
+		dst = c->key_buf;
+		dlen = &c->key_len;
+		cap = sizeof(c->key_buf);
+	}
+	if (*dlen + 24u < cap) {
+		int n = snprintf(dst + *dlen, cap - *dlen, "%s%d:%s",
+		    *dlen ? " " : "", proc_pid(pr), pr->p_comm);
+		if (n > 0) {
+			*dlen += (size_t)n;
+		}
+	}
+	return PROC_RETURNED;
+}
+static void
+sm6125_userspace_probe_cb(void *param0, void *param1 __unused)
+{
