+struct sm6125_ps_ctx {
+	char buf[320];
+	size_t len;
+	uint32_t count;
+};
+static int
+sm6125_ps_visit(proc_t pr, void *arg)
+{
+	struct sm6125_ps_ctx *c = (struct sm6125_ps_ctx *)arg;
+	c->count++;
+	if (c->len + 28u < sizeof(c->buf)) {
+		int n = snprintf(c->buf + c->len, sizeof(c->buf) - c->len, "%s%d:%s",
+		    c->len ? " " : "", proc_pid(pr), pr->p_comm);
+		if (n > 0) {
+			c->len += (size_t)n;
+		}
+	}
+	return PROC_RETURNED;
+}
+static void
+sm6125_userspace_probe_cb(void *param0, void *param1 __unused)
+{
+	extern void sm6125_emmc_dump_userspace_probe(
+	    uint32_t delay_s, uint32_t proc_count, const char *ps_summary);
+	uint32_t delay_s = (uint32_t)(uintptr_t)param0;
+	struct sm6125_ps_ctx ctx;
+	memset(&ctx, 0, sizeof(ctx));
+	proc_iterate(PROC_ALLPROCLIST, sm6125_ps_visit, &ctx, NULL, NULL);
+	sm6125_emmc_dump_userspace_probe(delay_s, ctx.count, ctx.buf);
+}
